    <!-- <var name="obstype">airnow aeronet viirs tempo pollen_dot_com</var> -->
    <metatask name="mm_get_obs">
    <var name="obstype">aeronet</var>
        <task name="mm_get_obs_#obstype#" cycledefs="monet" maxtries="20">
            &JOIN_RESOURCES_SHORT;
            &RESERVATION_SEND;
            <command>&SCRIPTS_DIR;/mm_get_obs.sh</command>
            
            <jobname><cyclestr>mm_get_obs_@Y@m@d@H_#obstype#</cyclestr></jobname>
            <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_get_obs_@Y@m@d@H_#obstype#.log</cyclestr></join>
            
