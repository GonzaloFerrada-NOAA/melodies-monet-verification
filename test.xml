<!ENTITY JOIN_RESOURCES_MEDMEM "<walltime>03:00:00</walltime><memory>64G</memory>">
<!ENTITY JOIN_RESOURCES_BIGMEM "<walltime>08:00:00</walltime><memory>200G</memory>">
<!ENTITY JOIN_PROC "1">



<!-- EDIT THESE ENTITIES FOR YOU EXPERIMENT --> 
<!ENTITY MELODIES_MONET_DIR "/scratch3/BMC/wrf-chem/Jordan/anamaria/workflow/output/">
<!ENTITY STMPLIST "/scratch3/BMC/wrf-chem/Jordan/anamaria/workflow/stmp_list.txt">
<!ENTITY NAMELIST "/scratch3/BMC/wrf-chem/Jordan/anamaria/workflow/monet_namelist">
<!ENTITY SCRIPTS_DIR "/scratch3/BMC/wrf-chem/Jordan/projects/mm_vx/src/melodies-monet-verification/"> 
<!ENTITY START_ANALYSIS_TIME_YYYYMMDD "20250601">
<!ENTITY END_ANALYSIS_TIME_YYYYMMDD "20250630">
<!-- EDIT THESE ENTITIES FOR YOU EXPERIMENT --> 

<!ENTITY LOG_DIR "&MELODIES_MONET_DIR;/logs">
<!ENTITY PLOTDIR "&MELODIES_MONET_DIR;/plot_output">

]>

