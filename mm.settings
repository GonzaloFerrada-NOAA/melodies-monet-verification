#!/bin/bash
# mm.settings -- shared environment for MELODIES-MONET tasks.
# Usage: source this file; do not execute it.
[[ "${BASH_SOURCE[0]}" == "$0" ]] && { echo "mm.settings must be sourced, not executed" >&2; exit 1; }

# Export VAR=default only if VAR is unset/empty; otherwise keep caller's value
_mm_default() {
  local var=$1 val=$2
  if [[ -z ${!var:-} ]]; then                # ${!var} = indirect expansion (value of the var named in $var)
    export "${var}=${val}"
    echo "settings: ${var}=${val}" >&2       # log to stderr, not stdout
  else
    export "${var}"                          # make sure an inherited value is exported too
  fi
}

# ---- Python environment ----
# _mm_default CONDA_ENV   "/scratch4/BMC/acomp/cheMPAS-Fire/envs/melodies-monet-nrt-vx"
_mm_default CONDA_ENV       "/scratch3/BMC/gsd-fv3-dev/Gonzalo.Ferrada/.HOME/miniconda-ursa/envs/melodies-monet"
_mm_default PYTHON          "${CONDA_ENV}/bin/python"
_mm_default SRUN_PYTHON     "srun --export=ALL --ntasks=1 --cpus-per-task=1 --mem=0 ${CONDA_ENV}/bin/python -u"
_mm_default MM_BIN          "${CONDA_ENV}/bin/melodies-monet"
_mm_default PARALLEL_BIN    "${CONDA_ENV}/bin/parallel"

# ---- Workflow directories (order matters: children derive from parents) ----
_mm_default MELODIES_MONET_DIR  "/scratch3/BMC/acomp/Gonzalo.Ferrada/repo-verif/melodies-monet-offline"
_mm_default SCRIPTS_DIR         "${MELODIES_MONET_DIR}/scripts"
_mm_default USH_DIR             "${MELODIES_MONET_DIR}/ush"
_mm_default TOOLS_DIR           "${MELODIES_MONET_DIR}/tools"
_mm_default AUX_DIR             "${MELODIES_MONET_DIR}/aux"
_mm_default YAML_DIR            "${AUX_DIR}/yaml_templates"
_mm_default OBS_DIR             "${MELODIES_MONET_DIR}/obs"
_mm_default OUTPUT_DIR          "${MELODIES_MONET_DIR}/output"
_mm_default FIG_DIR             "${MELODIES_MONET_DIR}/figures"
_mm_default RUN_DIR             "${MELODIES_MONET_DIR}/run"
_mm_default TOWEB_DIR           "${MELODIES_MONET_DIR}/toweb"
_mm_default CARTOPY_DATA_DIR    "${AUX_DIR}/cartopy"     # pre-downloaded Natural Earth data (tools/setup_offline_data.sh)

# ---- Experiments' yaml ----
_mm_default YAML_EXPERIMENTS    "${MELODIES_MONET_DIR}/experiments.yaml"

# ---- Cycle date (CDATE = YYYYMMDDHH) ----
source "${TOOLS_DIR}/workflow_tools.sh"
source "${TOOLS_DIR}/yaml_helpers.sh"

: "${CDATE:?CDATE not set (expected YYYYMMDDHH)}"
set_date_vars "${CDATE}"        # YYYYMMDD, YYYY, YY, MM, DD, HH, JJJ, CYCLE_DATE

# ---- melodies-monet options ----
_mm_default MELODIES_MONET_MAKE_PLOTS false # if true, the melodies-monet task will make spatial, line, timeseries PNG (more time consuming)
                                 # set to false if you're only interested on producing the interactive website.

# ---- Modules (load BEFORE set -x, or Lmod floods the log with trace lines) ----
# Batch shells may not have the `module` function defined; initialize it if missing
if ! type module &>/dev/null; then
  source /etc/profile.d/modules.sh        # check the actual init file on Ursa/Hera (see note below)
fi

module purge
module load rdhpcs-conda
module load cdo eccodes/2.34.0
# module load cdo
module load nco
module load ncl
module load imagemagick
module load wgrib2

module list

conda activate "${CONDA_ENV}"

unset -f _mm_default                         # don't leak the helper into the caller



# ---- Shell behavior for the calling task script ----
set -e                                            # exit on first failing command
export PS4='+ [\D{%F %T}] ${BASH_SOURCE##*/}:${LINENO}: '   # timestamp, file name, line number
set -x                                            # trace each command from here on

return 0
